{
  "$id": "https://raw.githubusercontent.com/ansible-community/molecule-hetznercloud/refs/heads/main/molecule_hetznercloud/driver.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["driver"],
  "properties": {
    "driver": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["molecule_hetznercloud"]
        },
        "options": {
          "type": "object"
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "image"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 30
          },
          "image": {
            "type": "string"
          },
          "server_type": {
            "type": "string",
            "default": "cx23"
          },
          "location": {
            "type": "string"
          },
          "user_data": {
            "type": "string"
          },
          "networks": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^[a-zA-Z0-9-_]+$": {
                "type": "object",
                "required": ["ip_range", "subnet"],
                "properties": {
                  "ip_range": {
                    "type": "string"
                  },
                  "subnet": {
                    "type": "object",
                    "required": ["ip"],
                    "additionalProperties": false,
                    "properties": {
                      "ip": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "default": "cloud"
                      },
                      "network_zone": {
                        "type": "string",
                        "default": "eu-central"
                      }
                    }
                  }
                }
              }
            }
          },
          "volumes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "size": {
                  "type": "integer",
                  "default": 10
                }
              }
            }
          }
        }
      }
    }
  }
}
